# Runtime only: configure the same values in the app and worker (see docs/ativacao.md).
# Replace every placeholder. Never commit the completed file.
DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@POSTGRES_INTERNAL_HOST:5432/DATABASE
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://APP_DOMAIN
ENCRYPTION_KEY=
S3_ENDPOINT=http://RUSTFS_INTERNAL_HOST:9000
S3_PUBLIC_ENDPOINT=https://S3_PUBLIC_DOMAIN
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=creatives
S3_FORCE_PATH_STYLE=true
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_TEXT=
DEEPSEEK_MODEL_VISION=
GROQ_API_KEY=
GROQ_WHISPER_MODEL=
# Monthly AI spend per operation in BRL cents (2000 = R$ 20) and provider prices in BRL cents per million tokens. Empty uses the defaults.
AI_MONTHLY_LIMIT_CENTS=
AI_PRICE_INPUT_CENTS_PER_MTOK=
AI_PRICE_CACHED_INPUT_CENTS_PER_MTOK=
AI_PRICE_OUTPUT_CENTS_PER_MTOK=
# Password reset by email through Resend. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Hotmart purchase webhook: the account's hottok and the product ids (comma-separated) that grant access.
HOTMART_HOTTOK=
HOTMART_PRODUCT_IDS=
# The mentor's private method (Markdown, base64), kept only on the server and appended to the master document. Empty uses the public document alone.
PRIVATE_METHOD_BASE64=
# Optional daily off-site backup, off while BACKUP_S3_BUCKET is empty (worker, 03:00
# America/Sao_Paulo). Any S3-compatible bucket outside
# this server, e.g. Cloudflare R2 or Backblaze B2. BACKUP_ENCRYPTION_KEY: 32 random bytes as
# base64, different from ENCRYPTION_KEY; keep both in a password manager, not with the backups.
BACKUP_S3_ENDPOINT=https://BACKUP_S3_ENDPOINT
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_BUCKET=
BACKUP_S3_FORCE_PATH_STYLE=false
BACKUP_ENCRYPTION_KEY=
# UTMify credentials and webhook secrets belong to each tenant in Integrations.
# Infrastructure credentials (Postgres/RustFS) are configured on their services.
